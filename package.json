{
  "name": "paper-log-parser",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "virtua": "^0.49.2",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.4",
    "@cloudflare/vitest-pool-workers": "^0.17.0",
    "@cloudflare/workers-types": "^4.20260630.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6",
    "wrangler": "^4.106.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
